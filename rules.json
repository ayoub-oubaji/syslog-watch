{"comment":"Alert rules for syslog-watch. Each rule: name, pattern (Python regex matched against the raw syslog datagram), severity (the least-severe message level that still triggers the rule; lower number = more severe).","rules":[{"name":"SSH failed login","pattern":"Failed (password|publickey)|authentication failure|Invalid user|LOGIN_FAILED","severity":6},{"name":"Interface up/down","pattern":"%LINK-3-UPDOWN|%LINEPROTO-5-UPDOWN|[Ii]nterface .* changed state to (up|down)","severity":5},{"name":"Configuration change","pattern":"%SYS-5-CONFIG_I|Configured from","severity":5},{"name":"OSPF neighbor change","pattern":"%OSPF-5-ADJCHG|neighbor.*(FULL|DOWN|EXSTART|INIT)","severity":5},{"name":"Critical severity catch-all","pattern":".*","severity":2}]}